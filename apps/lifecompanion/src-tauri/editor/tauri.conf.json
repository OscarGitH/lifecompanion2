{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "LifeCompanion Editor",
	"version": "../../package.json",
	"identifier": "org.lifecompanion2.editor",
	"build": {
		"beforeDevCommand": "pnpm editor:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm editor:build",
		"frontendDist": "../../dist/editor"
	},
	"app": {
		"windows": [
			{
				"title": "LifeCompanion Editor",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4OTEyRENCQkM1MTcwMEMKUldRTWNGRzh5eTJSYUE2aDNza1NnVHRLN3JSN1VCRnkvNnFjMFdyNUNaQkh0Q3hOaVIyTTJ4K3YK",
			"endpoints": [
				"https://github.com/OscarGitH/lifecompanion2/releases/latest/download/latest.json"
			]
		}
	}
}
